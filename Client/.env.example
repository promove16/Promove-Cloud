# ProMove Client — Vite environment template
#
# VITE_* variables are baked into the JS bundle at build time.
# Copy this file to Client/.env.local for local development.
#
# For local Docker Compose (both services on localhost):
#   VITE_API_BASE_URL=http://localhost:5000
#   VITE_SOCKET_URL=http://localhost:5001
#
# For AWS production (build command in CI/CD):
#   VITE_API_BASE_URL=https://api.yourdomain.com/api
#   VITE_SOCKET_URL=https://realtime.yourdomain.com
#   npm run build
#   aws s3 sync dist/ s3://promove-prod-frontend --delete

# Base URL for REST API requests.
# Local: http://localhost:5000
# Production: https://api.yourdomain.com/api
VITE_API_BASE_URL=http://localhost:5000

# Base URL for Socket.IO connections.
# Falls back to VITE_API_BASE_URL if not set (single-process local dev).
# Local compose (realtime on port 5001): http://localhost:5001
# Production: https://realtime.yourdomain.com
VITE_SOCKET_URL=http://localhost:5001

# Support email shown in service-unavailable toasts.
VITE_SUPPORT_EMAIL=charan.f.sde@gmail.com
