{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client", "node"]
  },
  "include": [
    "src/main.tsx",
    "src/api/**/*.ts",
    "src/components/**/*.ts",
    "src/components/**/*.tsx",
    "src/features/**/*.ts",
    "src/features/**/*.tsx",
    "src/hooks/**/*.ts",
    "src/pages/**/*.ts",
    "src/pages/**/*.tsx",
    "src/store/**/*.ts",
    "src/types/**/*.ts",
    "src/utils/**/*.ts",
    "vite.config.ts",
    "tailwind.config.ts"
  ],
  "exclude": ["node_modules", "dist", "src/app", "src/imports"]
}
