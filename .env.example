NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/promove_dev
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
UPSTASH_REDIS_HOST=your-upstash-host.upstash.io
# Optional: only needed if you want BullMQ to use a direct Redis TCP connection.
# UPSTASH_REDIS_PASSWORD=your-upstash-redis-password
REDIS_REQUEST_TIMEOUT_MS=1500
REDIS_REQUEST_RETRIES=0
BULLMQ_CONNECT_TIMEOUT_MS=5000
BULLMQ_COMMAND_TIMEOUT_MS=5000
JWT_ACCESS_SECRET="-----BEGIN PRIVATE KEY-----\nreplace-with-rsa-private-key\n-----END PRIVATE KEY-----"
JWT_REFRESH_SECRET="-----BEGIN PRIVATE KEY-----\nreplace-with-rsa-private-key\n-----END PRIVATE KEY-----"
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
CLIENT_URL=http://localhost:5173
MAX_USERS_YEAR_ONE=2000
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
FROM_EMAIL=noreply@example.com
