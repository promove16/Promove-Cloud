{
  "name": "promove-server",
  "version": "1.0.0",
  "private": true,
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "node -e \"process.env.TS_NODE_PREFER_TS_EXTS='true'; require('ts-node/register/transpile-only'); require('./src/server.ts');\"",
    "mock": "node ./scripts/dev/run-with-mock.js",
    "start": "npm run start:api",
    "start:all": "node dist/src/server.js",
    "start:api": "node dist/src/api.js",
    "start:realtime": "node dist/src/realtime.js",
    "start:worker": "node dist/src/worker.js",
    "start:scheduler": "node dist/src/scheduler.js",
    "start:seed": "npm run problem-bank:replace",
    "worker": "npm run start:worker",
    "worker:dev": "node -e \"process.env.TS_NODE_PREFER_TS_EXTS='true'; require('ts-node/register/transpile-only'); require('./src/worker.ts');\"",
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit",
    "test": "jest --runInBand",
    "db:seed": "ts-node ./src/scripts/seed.ts",
    "cleanup:help-center": "ts-node --transpile-only ./scripts/remove-help-center-data.ts",
    "backup:mongo:excel": "node dist/src/maintenance/backupMongoToS3.js",
    "backup:mongo:excel:dev": "node -e \"process.env.TS_NODE_PREFER_TS_EXTS='true'; require('ts-node/register/transpile-only'); require('./src/maintenance/backupMongoToS3.ts');\"",
    "backup:mongo": "node dist/src/maintenance/backupMongoToS3.js",
    "backup:mongo:dev": "node -e \"process.env.TS_NODE_PREFER_TS_EXTS='true'; require('ts-node/register/transpile-only'); require('./src/maintenance/backupMongoToS3.ts');\"",
    "user:reset-password": "node dist/src/maintenance/resetUserPassword.js",
    "user:reset-password:dev": "node -e \"process.env.TS_NODE_PREFER_TS_EXTS='true'; require('ts-node/register/transpile-only'); require('./src/maintenance/resetUserPassword.ts');\"",
    "problem-bank:replace": "ts-node --transpile-only ./src/modules/problemBank/replaceProblemBank.ts --force",
    "seed:users": "node ./scripts/seed-users.js",
    "sync:indexes": "node -e \"process.env.TS_NODE_PREFER_TS_EXTS='true'; require('ts-node/register/transpile-only'); require('./scripts/sync-indexes.ts');\"",
    "test:local": "node -e \"process.env.TS_NODE_PREFER_TS_EXTS='true'; require('ts-node/register/transpile-only'); require('./scripts/manual/test-local.ts');\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1015.0",
    "@aws-sdk/client-ses": "^3.1015.0",
    "@aws-sdk/s3-request-presigner": "^3.1037.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.71.0",
    "cloudinary": "^2.9.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.1",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.4",
    "pdfkit": "^0.17.2",
    "prom-client": "^15.1.3",
    "socket.io": "^4.8.3",
    "streamifier": "^0.1.1",
    "winston": "^3.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.17.57",
    "@types/nodemailer": "^8.0.0",
    "@types/pdfkit": "^0.17.5",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.4",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2"
  }
}
