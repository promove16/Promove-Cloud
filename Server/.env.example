# ProMove Server — AWS/Docker environment template
#
# For LOCAL Docker Compose testing:
#   1. Run: node generate-local-env.js   (creates Server/.env with generated RSA keys)
#   2. Run: docker-compose up --build
#
# For AWS ECS production:
#   - Store secret values (JWT keys, MONGODB_URI, SMTP_PASS) in AWS Secrets Manager.
#   - Set non-secret values as ECS task definition environment variables.
#   - Do NOT bake secrets into the image.
#
# Do NOT commit real secrets.

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=5000
CLIENT_URL=https://app.yourdomain.com
# Comma-separated CORS allowlist. CLIENT_URL is always included automatically.
ALLOWED_ORIGINS=https://app.yourdomain.com,http://localhost:5173
RATE_LIMIT_ENABLED=true
BCRYPT_ROUNDS=12

# Optional: force Node's DNS resolver for MongoDB SRV lookups when local DNS
# rejects _mongodb._tcp records. Example: Cloudflare + Google DNS.
# DNS_RESOLVERS=1.1.1.1,8.8.8.8

# Max concurrent in-flight requests before backpressure middleware sheds with 503.
# Default 1000. Tune per replica based on benchmarks.
MAX_INFLIGHT_REQUESTS=1000

# Optional: stable label for Prometheus metrics when running multiple replicas.
# Defaults to os.hostname() if unset. ECS task ID is a good value.
# INSTANCE_ID=promove-api-1

# -----------------------------------------------------------------------------
# MongoDB (store URI in Secrets Manager for production)
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/promove?retryWrites=true&w=majority
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=5
# MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
# MONGO_SOCKET_TIMEOUT_MS=30000
# MONGO_CONNECT_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# Redis — AWS ElastiCache Redis/Valkey
# Used for: cache, rate limiting, BullMQ queues, Socket.IO cross-replica adapter.
# -----------------------------------------------------------------------------
AWS_REDIS_HOST=promove-redis.xxxxxx.apse1.cache.amazonaws.com
AWS_REDIS_PORT=6379
AWS_REDIS_TLS=true
# Set only when AUTH token is enabled on the replication group (store in Secrets Manager).
# AWS_REDIS_AUTH_TOKEN=your-aws-redis-auth-token

# Alternative single-URL form (use one or the other, not both):
# REDIS_URL=rediss://:your-aws-redis-auth-token@promove-redis.xxxxxx.apse1.cache.amazonaws.com:6379

# Upstash Redis fallback for non-AWS hosts. If REDIS_URL is unset and
# UPSTASH_REDIS_HOST is present, the app uses this before AWS_REDIS_*.
# UPSTASH_REDIS_HOST=your-upstash-host.upstash.io
# UPSTASH_REDIS_PORT=6379
# UPSTASH_REDIS_TLS=true
# UPSTASH_REDIS_PASSWORD=your-upstash-redis-password
# UPSTASH_REDIS_REST_URL=https://your-upstash-host.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

REDIS_REQUEST_TIMEOUT_MS=1500
REDIS_REQUEST_RETRIES=0

BULLMQ_USE_REDIS=true
BULLMQ_CONNECT_TIMEOUT_MS=5000
BULLMQ_COMMAND_TIMEOUT_MS=5000

# -----------------------------------------------------------------------------
# JWT — RS256 RSA-2048 private keys (store in Secrets Manager for production)
# Generate locally with: node generate-local-env.js
# Escape newlines with \n when Secrets Manager or your env manager requires one-line values.
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET="-----BEGIN PRIVATE KEY-----\nreplace-with-rsa-private-key\n-----END PRIVATE KEY-----"
JWT_REFRESH_SECRET="-----BEGIN PRIVATE KEY-----\nreplace-with-rsa-private-key\n-----END PRIVATE KEY-----"
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
AUTH_ALLOW_REDIS_AUTH_FALLBACK=false

# -----------------------------------------------------------------------------
# GitHub OAuth (optional)
# -----------------------------------------------------------------------------
# GITHUB_CLIENT_ID=your_github_oauth_app_client_id
# GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
# GITHUB_OAUTH_CALLBACK_URL=https://api.yourdomain.com/api/users/github/callback

# -----------------------------------------------------------------------------
# File storage — AWS S3
# On ECS, use an IAM task role and leave the static key vars commented out.
# Static keys are only needed on non-AWS hosts or for temporary local testing.
# -----------------------------------------------------------------------------
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=promove-prod-uploads
AWS_S3_PUBLIC_BASE_URL=https://promove-prod-uploads.s3.ap-south-1.amazonaws.com
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS_SESSION_TOKEN=only-needed-for-temporary-sts-credentials

# Optional: legacy Cloudinary fallback (used only when S3 is not configured)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------------------
# Email / SES
# MAIL_TRANSPORT options:
#   ses   — AWS SES via ECS task role (preferred for production, requires AWS_REGION)
#   smtp  — SMTP credentials (requires SMTP_HOST or EMAIL_USER)
#   json  — logs email JSON to stdout (local dev and CI only)
#   auto  — chooses smtp if SMTP_HOST/EMAIL_USER is set, ses in production otherwise
# FROM_EMAIL must be a verified SES address or domain for production.
# -----------------------------------------------------------------------------
MAIL_TRANSPORT=ses
FROM_EMAIL=noreply@yourdomain.com

# SMTP fallback — enable by setting MAIL_TRANSPORT=smtp
# EMAIL_USER=your_gmail_address@gmail.com
# EMAIL_PASS=your_gmail_app_password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password_or_app_password

# Development email redirect — all outgoing emails go to this inbox instead.
# NEVER set this in production.
# DEV_EMAIL_REDIRECT=developer@example.com

# -----------------------------------------------------------------------------
# Dedicated process ports (same image, different ECS commands)
#   API:        node dist/src/api.js       — public, behind ALB on port 5000
#   Realtime:   node dist/src/realtime.js  — public, behind ALB on port 5000
#   Worker:     node dist/src/worker.js    — internal, metrics on WORKER_METRICS_PORT
#   Scheduler:  node dist/src/scheduler.js — internal, health on SCHEDULER_HEALTH_PORT
# -----------------------------------------------------------------------------
WORKER_METRICS_PORT=9091
SCHEDULER_HEALTH_PORT=9092
SCHEDULER_RESCHEDULE_INTERVAL_MS=3600000

# Legacy all-in-one mode: set true to run BullMQ workers inside the API process.
# Off by default in production. Used only for single-container dev/staging setups.
# RUN_WORKERS_INLINE=false

# -----------------------------------------------------------------------------
# MongoDB Excel backups to private S3 objects
# -----------------------------------------------------------------------------
# Manual run:
#   npm run build
#   npm run backup:mongo:excel
#
# Automatic run:
#   Set MONGO_EXCEL_BACKUP_ENABLED=true.
#   Split deployment: scheduler registers the repeatable BullMQ job; worker runs it.
#   Single-process deployment: RUN_WORKERS_INLINE=true lets the API process register
#   and run the BullMQ backup job.
#
# The backup creates one .xlsx workbook, one sheet per MongoDB collection, and
# uploads it to s3://$AWS_S3_BUCKET_NAME/$MONGO_EXCEL_BACKUP_S3_PREFIX/.
# Backups are uploaded with S3 SSE-S3 encryption and are not made public. After
# each successful backup, old .xlsx backups in this prefix older than the
# retention window are deleted.
MONGO_EXCEL_BACKUP_ENABLED=false
MONGO_EXCEL_BACKUP_RUN_ON_START=true
MONGO_EXCEL_BACKUP_CRON=0 2 * * *
MONGO_EXCEL_BACKUP_TIMEZONE=UTC
MONGO_EXCEL_BACKUP_RETENTION_DAYS=30
MONGO_EXCEL_BACKUP_S3_PREFIX=backups/mongo-excel
MONGO_EXCEL_BACKUP_MAX_DOCS_PER_COLLECTION=50000
MONGO_EXCEL_BACKUP_SAMPLE_SIZE=100
# Optional comma-separated allowlist. Leave empty to export all collections.
# MONGO_EXCEL_BACKUP_COLLECTIONS=users,workspaces,startups

# Disaster recovery backup. This creates a restorable mongodump archive in S3.
# Excel is for inspection; this archive is what you restore with mongorestore.
# Requires MongoDB Database Tools (`mongodump`) installed on the host/container.
MONGO_DISASTER_BACKUP_ENABLED=false
MONGO_DISASTER_BACKUP_S3_PREFIX=backups/mongo-archive
MONGODUMP_BIN=mongodump
